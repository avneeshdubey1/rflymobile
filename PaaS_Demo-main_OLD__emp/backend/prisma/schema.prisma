generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Admin
  Pilot
  Ops
  Finance
  BC
  BB
  Representative
}

enum CustomerType {
  BB
  BC
}

enum RequestSource {
  WalkIn
  Phone
  WhatsApp
  PartnerReferral
  Other
}

enum RequestStatus {
  Pending
  Assigned
  Accepted
  RepresentativeApprovalPending
  RepresentativeRejected
  InProgress
  Completed
  PaymentReceived
  TrackerUpdated
  Invoiced
}

enum InvoiceStatus {
  Draft
  Sent
  Paid
  Overdue
}

enum NotificationSeverity {
  info
  success
  warning
  error
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String   @unique
  email     String?
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  customerId String? @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])

  pilotAssignments          PilotAssignment[]            @relation("PilotAssignments")
  representativeAssignments PilotAssignment[]            @relation("AssignedRepresentative")
  representativeApprovals   BBRepresentativeApproval[]   @relation("RepresentativeApprovals")
  trackerUpdates            RequestTrackerEntry[]
  notifications             NotificationItem[]
}

model Customer {
  id               String       @id @default(uuid()) @db.Uuid
  name             String
  phone            String
  type             CustomerType
  address          String?
  region           String?
  billingCycleDays Int          @default(15)
  createdAt        DateTime     @default(now())

  requests ServiceRequest[]
  invoices Invoice[]
  users    User[]
}

model ServiceRequest {
  id                String        @id @default(uuid()) @db.Uuid
  requestNumber     Int           @default(autoincrement()) // For UI SR-001 format
  customerId        String        @db.Uuid
  customerType      CustomerType
  cropType          String
  fieldAreaAcres    Decimal       @db.Decimal(10, 2)
  requestedDate     DateTime      @db.Date
  requestedTimeSlot String
  chemical          String?
  sourceOfRequest   RequestSource
  status            RequestStatus @default(Pending)
  amountPerAcre     Decimal       @db.Decimal(10, 2)
  notes             String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customer   Customer          @relation(fields: [customerId], references: [id])
  assignment PilotAssignment?
  approval   BBRepresentativeApproval?
  payment    BCPayment?
  checklist  CompletionChecklist?
  tracker    RequestTrackerEntry?
}

model PilotAssignment {
  id                 String    @id @default(uuid()) @db.Uuid
  serviceRequestId   String    @unique @db.Uuid
  pilotId            String    @db.Uuid
  representativeId   String?   @db.Uuid
  assignedAt         DateTime  @default(now())
  acceptedAt         DateTime?
  startSprayingAt    DateTime?
  completeSprayingAt DateTime?

  serviceRequest  ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  pilot           User           @relation("PilotAssignments", fields: [pilotId], references: [id])
  representative  User?          @relation("AssignedRepresentative", fields: [representativeId], references: [id])
}

model BBRepresentativeApproval {
  id                   String    @id @default(uuid()) @db.Uuid
  serviceRequestId     String    @unique @db.Uuid
  representativeName   String
  representativePhone  String
  representativeUserId String?   @db.Uuid
  informedAt           DateTime  @default(now())
  isApproved           Boolean   @default(false)
  approvedAt           DateTime?
  rejectionReason      String?

  serviceRequest     ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  representativeUser User?          @relation("RepresentativeApprovals", fields: [representativeUserId], references: [id])
}

model BCPayment {
  id                String   @id @default(uuid()) @db.Uuid
  serviceRequestId  String   @unique @db.Uuid
  upiTransactionRef String
  amountPaid        Decimal  @db.Decimal(10, 2)
  paidAt            DateTime @default(now())
  adminInformedAt   DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
}

model CompletionChecklist {
  id                       String   @id @default(uuid()) @db.Uuid
  serviceRequestId         String   @unique @db.Uuid
  representativeInformedAt DateTime @default(now())
  billCollected            Boolean  @default(false)
  billPhotoUrl             String?
  screenshotSharedAt       DateTime @default(now())
  screenshotUrl            String?

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
}

model RequestTrackerEntry {
  id                 String   @id @default(uuid()) @db.Uuid
  serviceRequestId   String   @unique @db.Uuid
  updatedByOpsUserId String   @db.Uuid
  updatedAt          DateTime @default(now())
  notes              String   @db.Text

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  opsUser        User           @relation(fields: [updatedByOpsUserId], references: [id])
}

model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  invoiceNumber      Int           @default(autoincrement()) // For UI INV-001 format
  customerId         String        @db.Uuid
  billingPeriodStart DateTime      @db.Date
  billingPeriodEnd   DateTime      @db.Date
  jobIds             String[]      @db.Uuid
  totalAmount        Decimal       @db.Decimal(10, 2)
  invoiceDate        DateTime      @db.Date
  status             InvoiceStatus @default(Draft)
  pdfUrl             String?

  customer Customer @relation(fields: [customerId], references: [id])
}

model NotificationItem {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  title     String
  message   String
  severity  NotificationSeverity
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TimeSlot {
  id        String   @id @default(uuid()) @db.Uuid
  slot      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SystemConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

