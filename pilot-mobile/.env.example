# Use an address that the physical Android device can reach.
# The laptop and phone must be on the same network for local development.
# Provide the server origin. The app appends /api/mobile/v1 automatically.
# For this repository's local Docker stack, expose the edge/frontend port and use
# the laptop's LAN address when testing on a physical device.
EXPO_PUBLIC_API_URL=http://192.168.1.10:18080
