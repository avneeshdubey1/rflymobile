# Copy outside the repository and replace deployment-specific values.
# This file contains no secret values; secret variables point to root-readable files.

# Use a unique value for every company. It scopes containers, networks, and volumes.
DEPLOYMENT_NAME=replace-with-customer-neutral-id
IMAGE_TAG=replace-with-immutable-release-tag

# Nginx is intentionally bound to loopback by default. Put an approved HTTPS
# load balancer or host reverse proxy in front of it.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
CORS_ALLOWED_ORIGINS=https://replace-with-approved-domain.example
MAP_FRAME_ORIGINS=https://www.openstreetmap.org
TRUST_PROXY_HOPS=2
FIREBASE_RECOVERY_MAX_AUTH_AGE_MS=300000

# Non-secret database identifiers. Do not reuse a database/volume across companies.
POSTGRES_USER=operations
POSTGRES_DB=operations
POSTGRES_IMAGE=postgres:16-alpine

# Absolute paths outside the checkout. Generate locally; never commit their contents.
DB_PASSWORD_FILE=/etc/field-operations/replace-me/secrets/db_password
RECOVERY_HASH_SECRET_FILE=/etc/field-operations/replace-me/secrets/recovery_hash_secret

# Optional immutable registry image names. Local defaults are used when omitted.
BACKEND_IMAGE=field-operations-backend
MIGRATION_IMAGE=field-operations-migration
FRONTEND_IMAGE=field-operations-frontend

# Review from measured load before launch.
BACKEND_MEMORY_LIMIT=768m
BACKEND_CPU_LIMIT=1.0
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_CPU_LIMIT=0.5
POSTGRES_SHM_SIZE=256m
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
