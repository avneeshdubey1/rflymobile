# Copy outside the repository on the office server, for example:
# /opt/client-demo-app/deployment.env
#
# Demo-only: direct HTTP on :8088 without changing the existing Jitsi/Nginx
# virtual host. Do not use this file as a production security baseline.

DEPLOYMENT_NAME=rfly-onprem-demo
IMAGE_TAG=onprem-demo

# The handoff identified 8088 as the preferred free port. Re-check before use:
# ss -lntup | grep ':8088 ' || echo "Port 8088 is free"
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8088

# Exact HTTP demo origins. Add the verified public IP origin only after it is
# confirmed, e.g. http://PUBLIC_IP:8088. Do not use "*".
CORS_ALLOWED_ORIGINS=http://172.20.96.10:8088,http://127.0.0.1:8088
MAP_FRAME_ORIGINS=https://www.openstreetmap.org
TRUST_PROXY_HOPS=1
OPERATING_TIME_ZONE=Asia/Kolkata
MOBILE_API_ENABLED=false
MOBILE_SESSION_IDLE_TIMEOUT_MS=1800000
MOBILE_SESSION_ABSOLUTE_TIMEOUT_MS=28800000
MOBILE_SESSION_TOUCH_INTERVAL_MS=60000
MOBILE_MAX_INSTALLATIONS_PER_APP=2
MOBILE_MINIMUM_VERSION=1.0.0
MOBILE_RECOMMENDED_VERSION=1.0.0

# Keep OTP delivery disabled unless the demo explicitly requires portal OTP.
# Do not enable a real provider from this demo template.
OTP_DELIVERY_PROVIDER=disabled
OTP_CODE_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_MS=30000

# Isolated application database inside this Compose project. Do not use the
# host's existing PostgreSQL/MariaDB/MSSQL/MongoDB services.
POSTGRES_USER=rfly_demo
POSTGRES_DB=rfly_demo
POSTGRES_IMAGE=postgres:16-alpine

# Absolute paths outside the checkout. Generate locally; never commit contents.
DB_PASSWORD_FILE=/opt/client-demo-app/secrets/db_password
RECOVERY_HASH_SECRET_FILE=/opt/client-demo-app/secrets/recovery_hash_secret
OTP_HASH_SECRET_FILE=/opt/client-demo-app/secrets/otp_hash_secret
DEPLOY_BACKUP_DIRECTORY=/opt/client-demo-app/backups

# One-shot importer inputs. Do not place the workbook or key in the checkout.
IMPORT_WORKBOOK_DIRECTORY=/opt/client-demo-app/import-input
IMPORT_STAGING_KEY_FILE=/opt/client-demo-app/secrets/import_staging_key
IMPORT_STAGING_KEY_VERSION=v1
IMPORTER_UID=1007
IMPORTER_GID=1009

# Local build defaults. Set registry image names/tags only when using the
# release-image workflow artifacts instead of building on the server.
BACKEND_IMAGE=field-operations-backend
MIGRATION_IMAGE=field-operations-migration
FRONTEND_IMAGE=field-operations-frontend
IMPORTER_IMAGE=field-operations-importer

BACKEND_MEMORY_LIMIT=768m
BACKEND_CPU_LIMIT=1.0
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_CPU_LIMIT=0.5
IMPORTER_MEMORY_LIMIT=768m
IMPORTER_CPU_LIMIT=1.0
POSTGRES_SHM_SIZE=256m
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
