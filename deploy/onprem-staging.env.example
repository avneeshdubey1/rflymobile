# Copy this file outside the checkout to:
# /opt/client-staging-app/deployment.env
#
# Staging is a separate internal deployment. Never reuse the production
# DEPLOYMENT_NAME, secrets, PostgreSQL volume, database name, image tag, or port.

DEPLOYMENT_NAME=rfly-onprem-staging
IMAGE_TAG=onprem-staging

# Bind to the office LAN address only. Keep TCP 8089 closed to the public
# internet. Replace this address if the server's approved LAN address changes.
APP_BIND_ADDRESS=172.20.96.10
APP_PORT=8089
CORS_ALLOWED_ORIGINS=http://172.20.96.10:8089
MAP_FRAME_ORIGINS=https://www.openstreetmap.org
TRUST_PROXY_HOPS=1

# No real messaging provider is enabled in staging until its provider gate is
# approved. Use test accounts/data only; never copy the production database.
OTP_DELIVERY_PROVIDER=disabled
OTP_CODE_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_MS=30000

POSTGRES_USER=rfly_staging
POSTGRES_DB=rfly_staging
POSTGRES_IMAGE=postgres:16-alpine

DB_PASSWORD_FILE=/opt/client-staging-app/secrets/db_password
RECOVERY_HASH_SECRET_FILE=/opt/client-staging-app/secrets/recovery_hash_secret
OTP_HASH_SECRET_FILE=/opt/client-staging-app/secrets/otp_hash_secret

BACKEND_IMAGE=field-operations-backend
MIGRATION_IMAGE=field-operations-migration
FRONTEND_IMAGE=field-operations-frontend

BACKEND_MEMORY_LIMIT=768m
BACKEND_CPU_LIMIT=1.0
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_CPU_LIMIT=0.5
POSTGRES_SHM_SIZE=256m
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
