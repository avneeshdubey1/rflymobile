# Copy this file to .env and enter values locally. Never commit or send the values.
PORT=5000
DATABASE_URL=
# Required in production; generate and store outside the repository.
RECOVERY_HASH_SECRET=
OTP_HASH_SECRET=

# Browser/API perimeter. Production requires explicit origins and proxy hops.
# Add comma-separated origins only (no paths and never *).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Explicit map iframe providers. Production should list only the approved provider.
MAP_FRAME_ORIGINS=https://www.openstreetmap.org
# Local direct HTTP uses 0. Production requires the exact trusted proxy hop count (at least 1).
TRUST_PROXY_HOPS=0
ENFORCE_HTTPS=false
JSON_BODY_LIMIT_BYTES=131072

# Application-owned OTP. Local development may use "cli" to print the code in
# the backend terminal. Production must use a deliberately implemented provider
# adapter; "cli" and "test" are rejected in production.
OTP_DELIVERY_PROVIDER=cli
OTP_CODE_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_MS=30000

# Layered abuse controls. Production cannot disable rate limits.
RATE_LIMITS_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_RECOVERY_MAX=5
RATE_LIMIT_PUBLIC_INTAKE_MAX=30
RATE_LIMIT_WEBHOOK_MAX=60

# Strict service-area declines expire after the fixed approved 30-day period.
# The purge stores only a coordinate-free count in the audit log.
DECLINED_ENQUIRY_PURGE_INTERVAL_MS=86400000

# Revocable opaque-session and recovery challenge lifetimes.
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_ABSOLUTE_TIMEOUT_MS=28800000
SESSION_TOUCH_INTERVAL_MS=60000
RECOVERY_CODE_TTL_MS=600000
RECOVERY_MAX_ATTEMPTS=5

# Socket.IO connection, event, and payload limits.
SOCKET_MAX_PAYLOAD_BYTES=65536
SOCKET_EVENT_WINDOW_MS=60000
SOCKET_EVENT_MAX=120
SOCKET_CONNECTION_MAX=30

# Incoming provider events outside this window are rejected in production.
WEBHOOK_REPLAY_WINDOW_MS=300000

# Required only while running prisma:seed. Remove it from the process after seeding.
DEMO_USER_PASSWORD=

# Required only for a one-time/fresh handover reset. Never commit real values.
# This wipes operational data and creates exactly one Admin account.
CONFIRM_DATABASE_WIPE=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional providers remain mocked/fail-open when unset.
WHATSAPP_API_KEY=
WEATHER_API_KEY=
UPI_GATEWAY_KEY=
UPI_WEBHOOK_SECRET=

# Optional local/test timing overrides.
NOTIFICATION_CASCADE_TIMERS_MS=
CHAT_AUTO_CLOSE_AFTER_MS=
CHAT_AUTO_CLOSE_INTERVAL_MS=
