{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rfly.invalid/contracts/mobile/v1/mobile-api.schema.json",
  "title": "RFLY Pilot Mobile API v1 contract",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)(\\.\\d{1,2})?$"
    },
    "operatingCenter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "displayName"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "crewMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "crewRole"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "crewRole": {
          "enum": [
            "PRIMARY_PILOT",
            "COPILOT"
          ]
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "leadId",
        "revision",
        "status",
        "requestType",
        "crewFormationState",
        "dailySequence",
        "serviceWindowStart",
        "serviceWindowEnd",
        "farmer",
        "farm",
        "crop",
        "expectedAcreage",
        "actualAcreage",
        "issue",
        "maintenanceRequest",
        "cashCollection",
        "crew",
        "drone",
        "lmv",
        "operatingCenter",
        "operationalNotes",
        "updatedAt",
        "allowedActions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "leadId": {
          "$ref": "#/$defs/uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "SCHEDULED",
            "PILOT_ACCEPTED",
            "IN_PROGRESS",
            "COMPLETED",
            "CANCELLED",
            "FLAGGED"
          ]
        },
        "requestType": {
          "type": ["string", "null"],
          "enum": ["B2B", "B2C", null]
        },
        "crewFormationState": {
          "enum": [
            "PENDING_COPILOT_SELECTION",
            "READY",
            "LEGACY_INCOMPLETE"
          ]
        },
        "dailySequence": {
          "type": "integer",
          "minimum": 1
        },
        "serviceWindowStart": {
          "$ref": "#/$defs/timestamp"
        },
        "serviceWindowEnd": {
          "$ref": "#/$defs/timestamp"
        },
        "farmer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "displayName",
            "operationalPhone"
          ],
          "properties": {
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "operationalPhone": {
              "type": "string",
              "pattern": "^\\+[1-9]\\d{7,14}$"
            }
          }
        },
        "farm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "displayAddress",
            "plusCode",
            "latitude",
            "longitude"
          ],
          "properties": {
            "displayAddress": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "plusCode": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 160
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        "crop": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "expectedAcreage": {
          "$ref": "#/$defs/decimal"
        },
        "actualAcreage": {
          "anyOf": [
            {
              "$ref": "#/$defs/decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "issue": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "note",
                "reportedAt"
              ],
              "properties": {
                "category": {
                  "enum": [
                    "DRONE_MALFUNCTION",
                    "LMV_MALFUNCTION",
                    "SAFETY_HAZARD",
                    "WEATHER_BLOCKER",
                    "CUSTOMER_BLOCKER",
                    "OTHER"
                  ]
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "reportedAt": {
                  "$ref": "#/$defs/timestamp"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "maintenanceRequest": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "assetType", "reasonCode", "status", "processedBy", "updatedAt"],
              "properties": {
                "id": { "$ref": "#/$defs/uuid" },
                "assetType": { "enum": ["DRONE", "LMV"] },
                "reasonCode": { "enum": ["BATTERY_NOT_CHARGED", "PROPELLER_DAMAGED", "VEHICLE_BREAKDOWN", "TYRE_ISSUE", "ENGINE_ISSUE", "ELECTRICAL_ISSUE", "OTHER"] },
                "status": { "enum": ["PENDING", "ACCEPTED", "REJECTED", "RESOLVED"] },
                "processedBy": { "type": ["string", "null"], "maxLength": 120 },
                "updatedAt": { "$ref": "#/$defs/timestamp" }
              }
            },
            { "type": "null" }
          ]
        },
        "cashCollection": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "amount", "currencyCode", "method", "reviewStatus", "recordedAt"],
              "properties": {
                "id": { "$ref": "#/$defs/uuid" },
                "amount": { "$ref": "#/$defs/decimal" },
                "currencyCode": { "type": "string", "pattern": "^[A-Z]{3}$" },
                "method": { "const": "CASH" },
                "reviewStatus": { "enum": ["PENDING_REVIEW", "CONFIRMED", "VOIDED"] },
                "recordedAt": { "$ref": "#/$defs/timestamp" }
              }
            },
            { "type": "null" }
          ]
        },
        "crew": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/crewMember"
          }
        },
        "drone": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "code",
            "serialNumber"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "serialNumber": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        },
        "lmv": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "registrationNumber",
                "label"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/uuid"
                },
                "registrationNumber": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 120
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "operatingCenter": {
          "anyOf": [
            {
              "$ref": "#/$defs/operatingCenter"
            },
            {
              "type": "null"
            }
          ]
        },
        "operationalNotes": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "allowedActions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "SELECT_COPILOT",
              "ACCEPT",
              "REJECT",
              "START",
              "COMPLETE",
              "REPORT_ISSUE",
              "SEND_LOCATION",
              "COLLECT_PAYMENT"
            ]
          }
        }
      }
    },
    "loginRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email",
        "password",
        "installationKey",
        "platform",
        "appVersion",
        "deviceLabel"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "password": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128
        },
        "installationKey": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        },
        "platform": {
          "const": "ANDROID"
        },
        "appVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "deviceLabel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    },
    "loginResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "session",
        "installation",
        "profile",
        "requestId",
        "serverTime",
        "operatingTimeZone"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accessToken",
            "tokenType",
            "idleExpiresAt",
            "absoluteExpiresAt"
          ],
          "properties": {
            "accessToken": {
              "type": "string",
              "minLength": 32,
              "maxLength": 512
            },
            "tokenType": {
              "const": "Bearer"
            },
            "idleExpiresAt": {
              "$ref": "#/$defs/timestamp"
            },
            "absoluteExpiresAt": {
              "$ref": "#/$defs/timestamp"
            }
          }
        },
        "installation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "platform",
            "appVersion"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "platform": {
              "const": "ANDROID"
            },
            "appVersion": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            }
          }
        },
        "profile": {
          "$ref": "#/$defs/userProfile"
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "serverTime": {
          "$ref": "#/$defs/timestamp"
        },
        "operatingTimeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "bootstrapResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "apiVersion",
        "app",
        "serverTime",
        "operatingTimeZone",
        "profile",
        "operatingCenter",
        "assignmentWindow",
        "assignments",
        "capabilities",
        "featureFlags",
        "appVersions",
        "sync",
        "policies",
        "requestId"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "apiVersion": {
          "const": "v1"
        },
        "app": {
          "enum": [
            "PILOT_FIELD",
            "OPERATIONS"
          ]
        },
        "serverTime": {
          "$ref": "#/$defs/timestamp"
        },
        "operatingTimeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "profile": {
          "$ref": "#/$defs/userProfile"
        },
        "operatingCenter": {
          "anyOf": [
            {
              "$ref": "#/$defs/operatingCenter"
            },
            {
              "type": "null"
            }
          ]
        },
        "assignmentWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "$ref": "#/$defs/timestamp"
            },
            "to": {
              "$ref": "#/$defs/timestamp"
            }
          }
        },
        "assignments": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/assignment"
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "featureFlags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chat",
            "foregroundLocation",
            "issueReporting"
          ],
          "properties": {
            "chat": {
              "type": "boolean"
            },
            "foregroundLocation": {
              "type": "boolean"
            },
            "issueReporting": {
              "type": "boolean"
            }
          }
        },
        "appVersions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "recommended"
          ],
          "properties": {
            "minimum": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "recommended": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            }
          }
        },
        "sync": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cursor"
          ],
          "properties": {
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "policies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offlineGraceSeconds",
            "terminalCacheSeconds",
            "locationIntervalSeconds",
            "locationAccuracyMetres",
            "backgroundLocationEnabled"
          ],
          "properties": {
            "offlineGraceSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "terminalCacheSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "locationIntervalSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "locationAccuracyMetres": {
              "type": "integer",
              "minimum": 1
            },
            "backgroundLocationEnabled": {
              "const": false
            }
          }
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        }
      }
    },
    "mutationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientActionId",
        "assignmentId",
        "action",
        "outcome",
        "resultingRevision",
        "receivedAt"
      ],
      "properties": {
        "clientActionId": {
          "$ref": "#/$defs/uuid"
        },
        "assignmentId": {
          "$ref": "#/$defs/uuid"
        },
        "action": {
          "enum": [
            "ACCEPT",
            "REJECT",
            "START",
            "COMPLETE",
            "REPORT_ISSUE",
            "LOCATION"
          ]
        },
        "outcome": {
          "enum": [
            "APPLIED",
            "ALREADY_APPLIED",
            "CONFLICT",
            "REJECTED",
            "RETRY_LATER"
          ]
        },
        "resultingRevision": {
          "type": "integer",
          "minimum": 1
        },
        "receivedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "mutationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignmentId",
        "clientActionId",
        "action",
        "expectedRevision"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "COMPLETE"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "actualAcreage": {}
            },
            "required": [
              "actualAcreage"
            ]
          },
          "else": {
            "properties": {
              "actualAcreage": {}
            },
            "not": {
              "required": [
                "actualAcreage"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "REPORT_ISSUE"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "issueCategory": {},
              "issueNote": {}
            },
            "required": [
              "issueCategory",
              "issueNote"
            ]
          },
          "else": {
            "properties": {
              "issueCategory": {}
            },
            "not": {
              "required": [
                "issueCategory"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "REPORT_ISSUE",
                  "REJECT"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "issueNote"
            ]
          },
          "else": {
            "not": {
              "required": [
                "issueNote"
              ]
            }
          }
        }
      ],
      "properties": {
        "assignmentId": {
          "$ref": "#/$defs/uuid"
        },
        "clientActionId": {
          "$ref": "#/$defs/uuid"
        },
        "action": {
          "enum": [
            "ACCEPT",
            "REJECT",
            "START",
            "COMPLETE",
            "REPORT_ISSUE"
          ]
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1
        },
        "actualAcreage": {
          "$ref": "#/$defs/decimal"
        },
        "issueCategory": {
          "enum": [
            "DRONE_MALFUNCTION",
            "LMV_MALFUNCTION",
            "SAFETY_HAZARD",
            "WEATHER_BLOCKER",
            "CUSTOMER_BLOCKER",
            "OTHER"
          ]
        },
        "issueNote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "maintenanceReasonCode": {
          "enum": [
            "BATTERY_NOT_CHARGED",
            "PROPELLER_DAMAGED",
            "VEHICLE_BREAKDOWN",
            "TYRE_ISSUE",
            "ENGINE_ISSUE",
            "ELECTRICAL_ISSUE",
            "OTHER"
          ]
        }
      }
    },
    "syncRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor",
        "mutations"
      ],
      "properties": {
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/mutationRequest"
          }
        }
      }
    },
    "syncResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "serverTime",
        "mutationReceipts",
        "nextCursor",
        "fullResyncRequired",
        "changedAssignments",
        "removedAssignmentIds",
        "requestId",
        "operatingTimeZone"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "serverTime": {
          "$ref": "#/$defs/timestamp"
        },
        "mutationReceipts": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/mutationReceipt"
          }
        },
        "nextCursor": {
          "$ref": "#/$defs/cursor"
        },
        "fullResyncRequired": {
          "type": "boolean"
        },
        "changedAssignments": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/assignment"
          }
        },
        "removedAssignmentIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "operatingTimeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "changePage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "serverTime",
        "nextCursor",
        "fullResyncRequired",
        "changedAssignments",
        "removedAssignmentIds",
        "requestId",
        "operatingTimeZone"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "serverTime": {
          "$ref": "#/$defs/timestamp"
        },
        "nextCursor": {
          "$ref": "#/$defs/cursor"
        },
        "fullResyncRequired": {
          "type": "boolean"
        },
        "changedAssignments": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/assignment"
          }
        },
        "removedAssignmentIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "operatingTimeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "operationsCustomer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "phone",
        "preferredLanguage",
        "ownership",
        "totalAcres",
        "location",
        "recentLeads"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9]\\d{7,14}$"
        },
        "preferredLanguage": {
          "type": "string",
          "minLength": 2,
          "maxLength": 12
        },
        "ownership": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "OWNER",
            "TENANT",
            null
          ]
        },
        "totalAcres": {
          "anyOf": [
            {
              "$ref": "#/$defs/decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "village",
            "mandal",
            "district",
            "state"
          ],
          "properties": {
            "village": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 120
            },
