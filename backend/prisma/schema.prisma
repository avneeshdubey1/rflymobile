generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  FLEET_MANAGER
  PILOT
  FARMER
  BUSINESS
}

enum LeadStatus {
  NEW                     // accepted website request awaiting Sales review
  PROCESSED               // verified, inside range, ready for auto-assignment
  NEEDS_MANUAL_SCHEDULING // auto-assignment found no valid candidates
  MANUAL_CALL_REQUIRED    // farmer claims to have chemicals but no proof attached
  SCHEDULED               // pilot+drone assigned, awaiting pilot acceptance
  PILOT_ACCEPTED
  IN_PROGRESS
  COMPLETED
  FLAGGED                 // discrepancy, decommission, or admin flag
  CANCELLED
  REJECTED                // request or operational rejection
}

enum DroneStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum LMVStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum IntakeChannel {
  WEBSITE
  MANUAL_SALES
}

enum NotificationType {
  PILOT_ASSIGNMENT
  PILOT_SMS
  DISPATCH_CALL_TASK
  RESCHEDULE
  DRONE_DECOMMISSIONED
  MISSION_FLAGGED
  MISSION_COMPLETED
  LEAD_PROCESSED
  NEEDS_MANUAL_SCHEDULING
  WEATHER_RISK
  PAYMENT_PENDING
}

enum PaymentMethod {
  UPI
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PhoneVerificationPurpose {
  FARMER_PORTAL_AUTH
  FARMER_PHONE_LINK
  BUSINESS_RECOVERY
}

enum OtpDeliveryChannel {
  DISABLED
  TEST
  CLI
  WHATSAPP
  SMS
}

enum OtpDeliveryStatus {
  QUEUED
  SENT
  MOCKED
  FAILED
  DEAD_LETTER
  DISABLED
}

model OperatingCenter {
  id        String   @id @default(uuid())
  name      String                          // "Tenkasi HQ", "Kanyakumari Branch"
  latitude  Float
  longitude Float
  radiusKm  Float    @default(50)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  drones    Drone[]
  lmvs      LMV[]
  pilots    User[]
  leads     Lead[]
}

model User {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  phone                String?   @unique
  passwordHash         String
  role                 Role
  preferredLanguage    String    @default("ta")   // ISO-ish code, see §10
  preferences          Json      @default("{}")
  active               Boolean   @default(true)
  authVersion          Int       @default(1)
  emailVerifiedAt      DateTime?
  phoneVerifiedAt      DateTime?
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())

  // Pilot-specific
  homeCenter           OperatingCenter? @relation(fields: [homeCenterId], references: [id])
  homeCenterId         String?
  pilotLicenseExpiry   DateTime?        // DGCA placeholder, see §9

  // Farmer-specific
  village              String?
  district             String?

  // Business-specific
  businessName         String?
  gstNo                String?
  contactPerson        String?
  address              String?

  assignments          Assignment[]     @relation("PilotAssignments")
  chatSessions         ChatSession[]    @relation("ChatParticipants")
  notifications        Notification[]
  authSessions         AuthSession[]
  recoveryChallenges   PasswordRecoveryChallenge[]
  businessMemberships  BusinessMembership[]
  phoneVerificationChallenges PhoneVerificationChallenge[]
  customerProfile      Customer?          @relation("CustomerFarmerUser")
}

model Customer {
  id                String    @id @default(uuid())
  displayName       String
  phone             String    @unique
  preferredLanguage String    @default("ta")
  ownership         String?
  totalAcres        Float?
  village           String?
  mandal            String?
  district          String?
  state             String?
  kharifCrop        String?
  kharifOtherCrop   String?
  kharifAcres       Float?
  kharifTanks       Float?
  kharifSprayings   Int?
  rabiCrop          String?
  rabiOtherCrop     String?
  rabiAcres         Float?
  rabiTanks         Float?
  rabiSprayings     Int?
  summerCrop        String?
  summerOtherCrop   String?
  summerAcres       Float?
  summerTanks       Float?
  summerSprayings   Int?
  subscriptionCardNumber String?
  subscriptionYear  String?
  remarks           String?
  farmerUserId      String?   @unique
  createdByUserId   String?
  staffConfirmedAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  leads             Lead[]
  phoneVerificationChallenges PhoneVerificationChallenge[]
  farmerPortalUser  User?     @relation("CustomerFarmerUser", fields: [farmerUserId], references: [id], onDelete: SetNull)

  @@index([displayName])
  @@index([createdAt])
}

model PhoneVerificationChallenge {
  id                String                   @id @default(uuid())
  user              User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId            String?
  customer          Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId        String?
  phoneHash         String
  recipientLast4    String?
  purpose           PhoneVerificationPurpose
  codeHash          String
  attempts          Int                      @default(0)
  maxAttempts       Int                      @default(5)
  expiresAt         DateTime
  resendAvailableAt DateTime
  consumedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  deliveries        VerificationDeliveryAttempt[]
  outboxMessages    OtpDeliveryOutbox[]

  @@index([phoneHash, purpose, createdAt])
  @@index([userId, purpose, revokedAt])
  @@index([expiresAt])
}

model VerificationDeliveryAttempt {
  id                String                     @id @default(uuid())
  challenge         PhoneVerificationChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId       String
  channel           OtpDeliveryChannel
  status            OtpDeliveryStatus
  providerReference String?
  failureReason     String?
  createdAt         DateTime                   @default(now())

  @@index([challengeId, createdAt])
}

model OtpDeliveryOutbox {
  id                String                     @id @default(uuid())
  challenge         PhoneVerificationChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId       String
  channel           OtpDeliveryChannel
  status            OtpDeliveryStatus          @default(QUEUED)
  idempotencyKey    String                     @unique
  attempts          Int                        @default(0)
  nextAttemptAt     DateTime                   @default(now())
  processedAt       DateTime?
  lastError         String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([status, nextAttemptAt])
  @@index([challengeId])
}

model BusinessOrganization {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  email       String?
  gstNo       String?
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships BusinessMembership[]
  leads       Lead[]

  @@index([name])
  @@index([active])
}

model BusinessMembership {
  id             String               @id @default(uuid())
  organization   BusinessOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  active         Boolean              @default(true)
  createdByUserId String?
  createdAt      DateTime             @default(now())

  @@unique([organizationId, userId])
  @@index([userId, active])
  @@index([organizationId, active])
}

model AuthSession {
  id                String   @id @default(uuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  tokenHash         String   @unique
  csrfTokenHash     String
  authVersion       Int
  createdAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  revokeReason      String?

  @@index([userId, revokedAt])
  @@index([idleExpiresAt])
}

model PasswordRecoveryChallenge {
  id              String   @id
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          String?
  expectedAuthVersion Int?
  externalProofHash String? @unique
  identifierHash  String
  channel         String
  deliveryStatus  String
  codeHash        String
  attempts        Int      @default(0)
  maxAttempts     Int      @default(5)
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Drone {
  id                  String       @id @default(uuid())
  model               String
  serialNumber        String       @unique
  status              DroneStatus  @default(AVAILABLE)
  homeCenter          OperatingCenter @relation(fields: [homeCenterId], references: [id])
  homeCenterId        String
  airworthinessExpiry DateTime?    // DGCA placeholder, see §9
  lastMaintained       DateTime?
  createdAt           DateTime     @default(now())

  assignments         Assignment[]
}

model LMV {
  id             String          @id @default(uuid())
  registrationNo String          @unique
  label          String?
  status         LMVStatus       @default(AVAILABLE)
  homeCenter     OperatingCenter @relation(fields: [homeCenterId], references: [id])
  homeCenterId   String
  capacity       Int             @default(1)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  assignments    Assignment[]

  @@index([homeCenterId, status])
}

model Lead {
  id               String        @id @default(uuid())
  customer         Customer?     @relation(fields: [customerId], references: [id])
  customerId       String?
  businessOrganization BusinessOrganization? @relation(fields: [businessOrganizationId], references: [id])
  businessOrganizationId String?
  farmerName       String
  farmerPhone      String
  farmerAddress    String?
  latitude         Float?
  longitude        Float?
  acreage          Float
  cropType         String?
  notes            String?
  preferredLanguage String       @default("ta")
  status           LeadStatus    @default(NEW)
  intakeChannel    IntakeChannel
  matchedCenter    OperatingCenter? @relation(fields: [matchedCenterId], references: [id])
  matchedCenterId  String?
  distanceFromCenterKm Float?
  
  // Comprehensive form fields
  soilType         String?
  cropAgeWeeks     Int?
  chemicalBrand    String?
  sprayPurpose     String?
  hasChemical      Boolean       @default(true)
  chemicalProofUrl String?
  expectedDate     DateTime?
  expectedTime     String?
  waterBodyNearby  Boolean       @default(false)
  terrainType      String?

  createdAt        DateTime      @default(now())
  processedAt      DateTime?

  assignment       Assignment?
  notifications    Notification[]
  payments         PaymentRecord[]
  chatSessions     ChatSession[]

  @@index([customerId, createdAt])
  @@index([businessOrganizationId, createdAt])
}

// This is deliberately not a Lead: a declined request must never become
// schedulable or retain farm/route/acreage details. Contact fields support a
// short staff-recognition window only and are purged after the policy expiry.
model DeclinedEnquiry {
  id              String        @id @default(uuid())
  contactName     String
  contactPhone    String
  sourceChannel   IntakeChannel
  reason          String        @default("OUTSIDE_SERVICE_AREA")
  createdByUserId String?
  createdAt       DateTime      @default(now())
  expiresAt       DateTime

  @@index([expiresAt])
  @@index([contactPhone, createdAt])
}

model PricingConfig {
  id        String   @id @default(uuid())
  key       String   @unique   // e.g. "DISCREPANCY_THRESHOLD_PCT"
  value     Float               // placeholder values
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Assignment {
  id                String    @id @default(uuid())
  lead              Lead      @relation(fields: [leadId], references: [id])
  leadId            String    @unique
  pilot             User      @relation("PilotAssignments", fields: [pilotId], references: [id])
  pilotId           String
  drone             Drone     @relation(fields: [droneId], references: [id])
  droneId           String
  lmv               LMV?      @relation(fields: [lmvId], references: [id])
  lmvId             String?

  scheduledDate     DateTime
  autoAssigned      Boolean   @default(true)   // false if a Fleet Manager manually created/overrode it
  acceptedAt        DateTime?
  startedAt         DateTime?
  completedAt       DateTime?

  weatherCheckedAt  DateTime?
  weatherSuitable   Boolean?
  weatherNote       String?

  expectedAcreage   Float
  actualAcreage     Float?
  cost              Float?
  hasDiscrepancy    Boolean   @default(false)
  discrepancyNote   String?

  decommissionedMidMission Boolean @default(false)
  decommissionReason       String?

  lastKnownLat      Float?          // live GPS, most recent ping only
  lastKnownLng      Float?
  lastPingAt        DateTime?

  rescheduleHistory ScheduleChangeLog[]
  payments          PaymentRecord[]
  notificationEscalation NotificationEscalation?
  createdAt         DateTime  @default(now())
}

// Persists the notification-cascade clock so a server restart never loses a pilot follow-up.
model NotificationEscalation {
  id            String     @id @default(uuid())
  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  assignmentId  String     @unique
  stage         String     @default("PUSH_SENT") // PUSH_SENT, SMS_SENT, CALL_TASK_CREATED
  nextActionAt  DateTime
  reassignCount Int        @default(0)
  closedAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([nextActionAt])
}

model ScheduleChangeLog {
  id           String     @id @default(uuid())
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  assignmentId String
  oldDate      DateTime
  newDate      DateTime
  changedBy    String
  reason       String?
  createdAt    DateTime   @default(now())
}

model ChatSession {
  id                  String    @id @default(uuid())
  lead                Lead?     @relation(fields: [leadId], references: [id])
  leadId              String?
  participants        User[]    @relation("ChatParticipants")
  status              String    @default("OPEN")
  firstResponseReadAt DateTime?
  lastActivityAt      DateTime  @default(now())
  archivedAt          DateTime?
  closedAt            DateTime?
  createdAt           DateTime  @default(now())

  messages            ChatMessage[]
}

model ChatMessage {
  id          String      @id @default(uuid())
  session     ChatSession @relation(fields: [sessionId], references: [id])
  sessionId   String
  senderId    String
  content     String
  sentAt      DateTime    @default(now())
  readAt      DateTime?
}

model Notification {
  id          String            @id @default(uuid())
  type        NotificationType
  recipient   User              @relation(fields: [recipientId], references: [id])
  recipientId String
  lead        Lead?             @relation(fields: [leadId], references: [id])
  leadId      String?
  message     String
  readAt      DateTime?
  createdAt   DateTime          @default(now())
}

model PaymentRecord {
  id            String        @id @default(uuid())
  lead          Lead          @relation(fields: [leadId], references: [id])
  leadId        String
  assignment    Assignment    @relation(fields: [assignmentId], references: [id])
  assignmentId  String
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  upiLink       String?
  upiTransactionId String?
  markedCashBy  String?               // userId if manually marked collected
  createdAt     DateTime      @default(now())
  resolvedAt    DateTime?
}

// Append-only. Never updated or deleted — this is the source for the
// Logbook/CRM job-lifecycle timeline view
model AuditLog {
  id         String   @id @default(uuid())
  entityType String              // "Lead" | "Assignment" | "Drone" | ...
  entityId   String
  action     String              // "STATUS_CHANGE" | "ADMIN_OVERRIDE" | "RESCHEDULE" | ...
  actorId    String?             // null for system/automated actions
  beforeState Json?
  afterState  Json?
  reason      String?
  createdAt  DateTime @default(now())
}
