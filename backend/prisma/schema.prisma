model CustomerSubscription {
  id         String             @id @default(uuid())
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  cardNumber String?            @unique @db.VarChar(80)
  schemeCode String?            @db.VarChar(80)
  status     SubscriptionStatus @default(UNKNOWN)
  validFrom  DateTime?          @db.Date
  validUntil DateTime?          @db.Date
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([customerId, status])
}

model LeadSprayPurpose {
  id            String   @id @default(uuid())
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId        String
  purposeCode   String   @db.VarChar(80)
  labelSnapshot String?  @db.VarChar(160)
  createdAt     DateTime @default(now())

  @@unique([leadId, purposeCode])
  @@index([purposeCode])
}

// One operator-controlled batch represents one source file. Source rows are
// encrypted staging records; only approved, valid rows can create canonical
// records through the importer transaction.
model ImportBatch {
  id                       String            @id @default(uuid())
  sourceType               ImportSourceType
  originalFileName         String            @db.VarChar(255)
  fileSizeBytes            BigInt
  workbookType             String            @default("XLSX") @db.VarChar(20)
  fileChecksum             String            @db.Char(64)
  mappingVersion           String            @db.VarChar(80)
  attemptNumber            Int               @default(1)
  supersedesBatch          ImportBatch?      @relation("ImportBatchAttempts", fields: [supersedesBatchId], references: [id], onDelete: Restrict)
  supersedesBatchId        String?
  supersededBy             ImportBatch[]     @relation("ImportBatchAttempts")
  dryRunPlanHash           String?           @db.Char(64)
  referenceDataFingerprint String?           @db.Char(64)
  approvalReference        String?           @db.VarChar(160)
  backupEvidenceReference  String?           @db.VarChar(160)
  expectedDeploymentName   String?           @db.VarChar(120)
  reconciliationChecksum   String?           @db.Char(64)
  status                   ImportBatchStatus @default(STAGED)
  totalRows                Int               @default(0)
  validRows                Int               @default(0)
  rejectedRows             Int               @default(0)
  reviewRows               Int               @default(0)
  importedRows             Int               @default(0)
  skippedRows              Int               @default(0)
  safeReport               Json?
  rawRetentionUntil        DateTime
  createdBy                User?             @relation("ImportBatchCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId          String?
  approvedBy               User?             @relation("ImportBatchApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId         String?
  approvedAt               DateTime?
  importStartedAt          DateTime?
  completedAt              DateTime?
  reconciledAt             DateTime?
  rolledBackAt             DateTime?
  failureCode              String?           @db.VarChar(80)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  sourceRecords    SourceRecord[]
  createdCustomers Customer[]     @relation("ImportBatchCreatedCustomers")

  @@unique([fileChecksum, mappingVersion, attemptNumber])
  @@index([status, createdAt])
  @@index([rawRetentionUntil])
  @@index([supersedesBatchId])
  @@index([createdByUserId])
  @@index([approvedByUserId])
}

model SourceRecord {
  id                   String             @id @default(uuid())
  batch                ImportBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId              String
  sourceSystem         ImportSourceType
  sheetName            String             @db.VarChar(120)
  sourceRowNumber      Int
  externalRecordId     String?            @db.VarChar(160)
  rowFingerprint       String             @db.Char(64)
  phoneFingerprint     String?            @db.Char(64)
  recipientLast4       String?            @db.VarChar(4)
  status               SourceRecordStatus @default(PENDING)
  reasonCode           String?            @db.VarChar(80)
  safeDetails          Json?
  proposedOutcome      String?            @db.VarChar(80)
  finalOutcome         String?            @db.VarChar(80)
  encryptedPayload     Bytes
  payloadIv            Bytes
  payloadAuthTag       Bytes
  encryptionKeyVersion String             @db.VarChar(40)
  payloadExpiresAt     DateTime
  customer             Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId           String?
  resultEntityType     String?            @db.VarChar(80)
  resultEntityId       String?
  committedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  historicalService HistoricalServiceRecord?
  villageVisit      VillageVisit?

  @@unique([batchId, sheetName, sourceRowNumber])
  // The same source row can appear in a later immutable import attempt. The
  // canonical importer performs duplicate reconciliation; staging evidence
  // must therefore index, not globally own, an external source identifier.
  @@index([sourceSystem, externalRecordId])
  @@index([batchId, status])
  @@index([rowFingerprint])
  @@index([phoneFingerprint])
  @@index([payloadExpiresAt])
  @@index([customerId])
}

model HistoricalServiceRecord {
  id                String                  @id @default(uuid())
  customer          Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId        String
  sourceRecord      SourceRecord            @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)
  sourceRecordId    String                  @unique
  farmLocation      FarmLocation?           @relation(fields: [farmLocationId], references: [id], onDelete: SetNull)
  farmLocationId    String?
  crop              Crop?                   @relation(fields: [cropId], references: [id], onDelete: SetNull)
  cropId            String?
  operatingCenter   OperatingCenter?        @relation(fields: [operatingCenterId], references: [id], onDelete: SetNull)
  operatingCenterId String?
  serviceDate       DateTime?               @db.Date
  rawCropName       String?                 @db.VarChar(160)
  servicedAcres     Decimal?                @db.Decimal(12, 2)
  legacyZone        String?                 @db.VarChar(160)
  status            HistoricalServiceStatus @default(COMPLETED)
  notes             String?                 @db.VarChar(1000)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([customerId, serviceDate])
  @@index([farmLocationId])
  @@index([cropId])
  @@index([operatingCenterId])
}

model VillageVisit {
  id                       String       @id @default(uuid())
  customer                 Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId               String
  sourceRecord             SourceRecord @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)
  sourceRecordId           String       @unique
  collector                User?        @relation("VillageVisitCollector", fields: [collectorUserId], references: [id], onDelete: SetNull)
  collectorUserId          String?
  collectorNameRaw         String?      @db.VarChar(160)
  employeeCodeRaw          String?      @db.VarChar(80)
  administrativeLocation   Location?    @relation(fields: [administrativeLocationId], references: [id], onDelete: SetNull)
  administrativeLocationId String?
  crop                     Crop?        @relation(fields: [cropId], references: [id], onDelete: SetNull)
  cropId                   String?
  visitedAt                DateTime?
  rawCropName              String?      @db.VarChar(160)
  observedAcres            Decimal?     @db.Decimal(12, 2)
  fertilizerShop           String?      @db.VarChar(240)
  expectedSpraying         String?      @db.VarChar(240)
  farmerType               String?      @db.VarChar(80)
  notes                    String?      @db.VarChar(1000)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@index([customerId, visitedAt])
  @@index([collectorUserId, visitedAt])
  @@index([administrativeLocationId])
  @@index([cropId])
}

model CustomerHistory {
  id            String           @id @default(uuid())
  customer      Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId    String
  version       Int
  eventType     HistoryEventType
  changedFields Json             @default("{}")
  actor         User?            @relation("CustomerHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorUserId   String?
  reason        String?          @db.VarChar(500)
  effectiveAt   DateTime?
  recordedAt    DateTime         @default(now())

  @@unique([customerId, version])
  @@index([customerId, recordedAt])
  @@index([actorUserId])
}

