generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  FLEET_MANAGER
  PILOT
  FARMER
  BUSINESS
}

enum LeadStatus {
  NEW // accepted website request awaiting Sales review
  PROCESSED // verified, inside range, ready for auto-assignment
  NEEDS_MANUAL_SCHEDULING // auto-assignment found no valid candidates
  MANUAL_CALL_REQUIRED // farmer claims to have chemicals but no proof attached
  SCHEDULED // pilot+drone assigned, awaiting pilot acceptance
  PILOT_ACCEPTED
  IN_PROGRESS
  COMPLETED
  FLAGGED // discrepancy, decommission, or admin flag
  CANCELLED
  REJECTED // request or operational rejection
}

enum CrewFormationState {
  PENDING_COPILOT_SELECTION
  READY
  LEGACY_INCOMPLETE
}

enum MobileApp {
  PILOT_FIELD
  OPERATIONS
}

enum MobileMutationOutcome {
  APPLIED
  ALREADY_APPLIED
  CONFLICT
  REJECTED
  RETRY_LATER
}

enum DroneStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum LMVStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum IntakeChannel {
  WEBSITE
  MANUAL_SALES
}

enum NotificationType {
  PILOT_ASSIGNMENT
  PILOT_SMS
  DISPATCH_CALL_TASK
  RESCHEDULE
  DRONE_DECOMMISSIONED
  MISSION_FLAGGED
  MISSION_COMPLETED
  LEAD_PROCESSED
  NEEDS_MANUAL_SCHEDULING
  WEATHER_RISK
  PAYMENT_PENDING
}

enum PaymentMethod {
  UPI
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PhoneVerificationPurpose {
  FARMER_PORTAL_AUTH
  FARMER_PHONE_LINK
  BUSINESS_RECOVERY
}

enum OtpDeliveryChannel {
  DISABLED
  TEST
  CLI
  WHATSAPP
  SMS
}

enum OtpDeliveryStatus {
  QUEUED
  SENT
  MOCKED
  FAILED
  DEAD_LETTER
  DISABLED
}

enum AssetOperationalState {
  IN_SERVICE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum AssetAvailabilityState {
  AVAILABLE
  ASSIGNED
  UNAVAILABLE
}

enum WeatherUnavailableAction {
  SCHEDULE_WITH_WARNING
  MANUAL_REVIEW
}

enum CropSeason {
  KHARIF
  RABI
  SUMMER
  OTHER
}

enum LanguageProficiency {
  PRIMARY
  STRONG
  WORKING
  BASIC
}

enum FarmLocationSource {
  STAFF_CAPTURED
  PUBLIC_WEBSITE
  IMPORTED_ZOHO
  IMPORTED_GOOGLE_FORMS
}

enum ImportSourceType {
  FARMER_WORKBOOK
  ZOHO_CRM
  GOOGLE_FORMS
}

enum ImportBatchStatus {
  STAGED
  VALIDATED
  REVIEW_REQUIRED
  APPROVED
  IMPORTING
  COMPLETED
  FAILED
  ROLLED_BACK
  SUPERSEDED
}

enum SourceRecordStatus {
  PENDING
  VALID
  REJECTED
  REVIEW_REQUIRED
  IMPORTED
  SKIPPED
  ROLLED_BACK
}

enum HistoricalServiceStatus {
  COMPLETED
  UNKNOWN
  CORRECTED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  UNKNOWN
}

enum HistoryEventType {
  BASELINE
  CREATED
  UPDATED
  STATUS_CHANGED
  CORRECTED
  ARCHIVED
  IMPORTED
}

model OperatingCenter {
  id                       String    @id @default(uuid())
  code                     String?   @unique
  name                     String // "Tenkasi HQ", "Kanyakumari Branch"
  latitude                 Float
  longitude                Float
  plusCode                 String?
  radiusKm                 Float     @default(50)
  active                   Boolean   @default(true)
  administrativeLocation   Location? @relation(fields: [administrativeLocationId], references: [id], onDelete: SetNull)
  administrativeLocationId String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  drones             Drone[]
  lmvs               LMV[]
  pilots             User[]
  leads              Lead[]
  historicalServices HistoricalServiceRecord[]

  @@index([administrativeLocationId])
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  phone             String?   @unique
  passwordHash      String
  role              Role
  preferredLanguage String    @default("ta") // ISO-ish code, see §10
  preferences       Json      @default("{}")
  active            Boolean   @default(true)
  authVersion       Int       @default(1)
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  archivedAt        DateTime?
  employeeCode      String?   @unique
  createdAt         DateTime  @default(now())

  // Pilot-specific
  homeCenter         OperatingCenter? @relation(fields: [homeCenterId], references: [id])
  homeCenterId       String?
  pilotLicenseExpiry DateTime? // DGCA placeholder, see §9
  // Compatibility-only home-drone preference. A service assignment always
  // carries exactly one operational drone for both Pilot and Copilot.
  assignedDrone      Drone?           @relation("PilotAssignedDrone", fields: [assignedDroneId], references: [id])
  assignedDroneId    String?          @unique
  idProof            String?
  licenseId          String?
  addressLine1       String?
  addressLine2       String?
  state              String?
  city               String?
  pincode            String?

  // Farmer-specific
  village  String?
  district String?

  // Business-specific
  businessName  String?
  gstNo         String?
  contactPerson String?
  address       String?

  assignments                   Assignment[]                 @relation("PilotAssignments")
  copilotAssignments            Assignment[]                 @relation("CopilotAssignments")
  chatSessions                  ChatSession[]                @relation("ChatParticipants")
  notifications                 Notification[]
  authSessions                  AuthSession[]
  recoveryChallenges            PasswordRecoveryChallenge[]
  businessMemberships           BusinessMembership[]
  phoneVerificationChallenges   PhoneVerificationChallenge[]
  customerProfile               Customer?                    @relation("CustomerFarmerUser")
  importBatchesCreated          ImportBatch[]                @relation("ImportBatchCreatedBy")
  importBatchesApproved         ImportBatch[]                @relation("ImportBatchApprovedBy")
  verifiedFarmLocations         FarmLocation[]               @relation("FarmLocationVerifiedBy")
  collectedVillageVisits        VillageVisit[]               @relation("VillageVisitCollector")
  customerHistoryEvents         CustomerHistory[]            @relation("CustomerHistoryActor")
  leadHistoryEvents             LeadHistory[]                @relation("LeadHistoryActor")
  droneHistoryEvents            DroneHistory[]               @relation("DroneHistoryActor")
  lmvHistoryEvents              LMVHistory[]                 @relation("LMVHistoryActor")
  autoAssignmentPoliciesUpdated AutoAssignmentPolicy[]       @relation("AutoAssignmentPolicyUpdatedBy")
  mobileInstallations           MobileInstallation[]
  mobileSessions                MobileSession[]
}

model Customer {
  id                     String    @id @default(uuid())
  displayName            String
  phone                  String    @unique
  preferredLanguage      String    @default("ta")
  ownership              String?
  totalAcres             Float?
  village                String?
  mandal                 String?
  district               String?
  state                  String?
  kharifCrop             String?
  kharifOtherCrop        String?
  kharifAcres            Float?
  kharifTanks            Float?
  kharifSprayings        Int?
  rabiCrop               String?
  rabiOtherCrop          String?
  rabiAcres              Float?
  rabiTanks              Float?
  rabiSprayings          Int?
  summerCrop             String?
  summerOtherCrop        String?
  summerAcres            Float?
  summerTanks            Float?
  summerSprayings        Int?
  subscriptionCardNumber String?
  subscriptionYear       String?
  remarks                String?
  active                 Boolean   @default(true)
  createdByImportBatchId String?
  farmerUserId           String?   @unique
  createdByUserId        String?
  staffConfirmedAt       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  leads                       Lead[]
  phoneVerificationChallenges PhoneVerificationChallenge[]
  farmerPortalUser            User?                        @relation("CustomerFarmerUser", fields: [farmerUserId], references: [id], onDelete: SetNull)
  createdByImportBatch        ImportBatch?                 @relation("ImportBatchCreatedCustomers", fields: [createdByImportBatchId], references: [id], onDelete: SetNull)
  farmLocations               FarmLocation[]
  languagePreferences         CustomerLanguagePreference[]
  seasonalCrops               CustomerSeasonalCrop[]
  subscriptions               CustomerSubscription[]
  sourceRecords               SourceRecord[]
  historicalServices          HistoricalServiceRecord[]
  villageVisits               VillageVisit[]
  history                     CustomerHistory[]

  @@index([displayName])
  @@index([createdAt])
  @@index([active, updatedAt])
  @@index([createdByImportBatchId])
}

model PhoneVerificationChallenge {
  id                String                   @id @default(uuid())
  user              User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId            String?
  customer          Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId        String?
  phoneHash         String
  recipientLast4    String?
  purpose           PhoneVerificationPurpose
  codeHash          String
  attempts          Int                      @default(0)
  maxAttempts       Int                      @default(5)
  expiresAt         DateTime
  resendAvailableAt DateTime
  consumedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  deliveries     VerificationDeliveryAttempt[]
  outboxMessages OtpDeliveryOutbox[]

  @@index([phoneHash, purpose, createdAt])
  @@index([userId, purpose, revokedAt])
  @@index([expiresAt])
}

model VerificationDeliveryAttempt {
  id                String                     @id @default(uuid())
  challenge         PhoneVerificationChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId       String
  channel           OtpDeliveryChannel
  status            OtpDeliveryStatus
  providerReference String?
  failureReason     String?
  createdAt         DateTime                   @default(now())

  @@index([challengeId, createdAt])
}

model OtpDeliveryOutbox {
  id             String                     @id @default(uuid())
  challenge      PhoneVerificationChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId    String
  channel        OtpDeliveryChannel
  status         OtpDeliveryStatus          @default(QUEUED)
  idempotencyKey String                     @unique
  attempts       Int                        @default(0)
  nextAttemptAt  DateTime                   @default(now())
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([status, nextAttemptAt])
  @@index([challengeId])
}

model BusinessOrganization {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  gstNo     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships BusinessMembership[]
  leads       Lead[]

  @@index([name])
  @@index([active])
}

model BusinessMembership {
  id              String               @id @default(uuid())
  organization    BusinessOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  active          Boolean              @default(true)
  createdByUserId String?
  createdAt       DateTime             @default(now())

  @@unique([organizationId, userId])
  @@index([userId, active])
  @@index([organizationId, active])
}

model AuthSession {
  id                String    @id @default(uuid())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  tokenHash         String    @unique
  csrfTokenHash     String
  authVersion       Int
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  revokeReason      String?

  @@index([userId, revokedAt])
  @@index([idleExpiresAt])
}

model MobileInstallation {
  id                  String    @id @default(uuid())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  app                 MobileApp
  installationKeyHash String    @unique @db.VarChar(128)
  label               String?   @db.VarChar(80)
  createdAt           DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  revokedAt           DateTime?
  revokeReason        String?   @db.VarChar(200)

  sessions MobileSession[]
  receipts MobileMutationReceipt[]

  @@index([userId, app, revokedAt])
}

model MobileSession {
  id                String             @id @default(uuid())
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  installation      MobileInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  installationId    String
  tokenHash         String             @unique @db.VarChar(128)
  authVersion       Int
  createdAt         DateTime           @default(now())
  lastSeenAt        DateTime           @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  revokeReason      String?            @db.VarChar(200)

  @@index([userId, revokedAt])
  @@index([installationId, revokedAt])
  @@index([idleExpiresAt])
}

model MobileMutationReceipt {
  id             String                @id @default(uuid())
  installation   MobileInstallation    @relation(fields: [installationId], references: [id], onDelete: Cascade)
  installationId String
  assignment     Assignment?           @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  assignmentId   String?
  actionId       String                @db.VarChar(128)
  operation      String                @db.VarChar(64)
  requestHash    String                @db.VarChar(128)
  outcome        MobileMutationOutcome
  safeResult     Json
  createdAt      DateTime              @default(now())

  @@unique([installationId, actionId])
  @@index([assignmentId, createdAt])
  @@index([createdAt])
}

model PasswordRecoveryChallenge {
  id                  String    @id
  user                User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId              String?
  expectedAuthVersion Int?
  externalProofHash   String?   @unique
  identifierHash      String
  channel             String
  deliveryStatus      String
  codeHash            String
  attempts            Int       @default(0)
  maxAttempts         Int       @default(5)
  expiresAt           DateTime
  usedAt              DateTime?
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Drone {
  id                  String                 @id @default(uuid())
  name                String?
  type                String?
  category            String?
  model               String
  manufacturer        String?
  serialNumber        String                 @unique
  uin                 String?                @unique
  location            String?
  tankCapacity        Float?
  tankCapacityLitres  Float?
  batteryCapacity     Int?
  batteryCapacityMah  Int?
  endurance           Int?
  enduranceMinutes    Int?
  certified           Boolean                @default(false)
  serviceType         String?
  status              DroneStatus            @default(AVAILABLE)
  operationalState    AssetOperationalState  @default(IN_SERVICE)
  availabilityState   AssetAvailabilityState @default(AVAILABLE)
  homeCenter          OperatingCenter        @relation(fields: [homeCenterId], references: [id])
  homeCenterId        String
  airworthinessExpiry DateTime?
  lastMaintained      DateTime?
  archivedAt          DateTime?
  createdAt           DateTime               @default(now())

  assignments        Assignment[]
  copilotAssignments Assignment[]   @relation("CopilotDroneAssignments")
  assignedPilot      User?          @relation("PilotAssignedDrone")
  history            DroneHistory[]

  @@index([homeCenterId, archivedAt, operationalState, availabilityState])
}

model LMV {
  id                String                 @id @default(uuid())
  registrationNo    String                 @unique
  label             String?
  status            LMVStatus              @default(AVAILABLE)
  operationalState  AssetOperationalState  @default(IN_SERVICE)
  availabilityState AssetAvailabilityState @default(AVAILABLE)
  homeCenter        OperatingCenter        @relation(fields: [homeCenterId], references: [id])
  homeCenterId      String
  capacity          Int                    @default(1)
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  assignments Assignment[]
  history     LMVHistory[]

  @@index([homeCenterId, status])
  @@index([homeCenterId, operationalState, availabilityState])
}

model Lead {
  id                     String                @id @default(uuid())
  customer               Customer?             @relation(fields: [customerId], references: [id])
  customerId             String?
  businessOrganization   BusinessOrganization? @relation(fields: [businessOrganizationId], references: [id])
  businessOrganizationId String?
  farmerName             String
  farmerPhone            String
  farmerAddress          String?
  farmLocation           FarmLocation?         @relation(fields: [farmLocationId], references: [id], onDelete: SetNull)
  farmLocationId         String?
  latitude               Float?
  longitude              Float?
  acreage                Float
  acreageDecimal         Decimal?              @db.Decimal(12, 2)
  crop                   Crop?                 @relation(fields: [cropId], references: [id], onDelete: SetNull)
  cropId                 String?
  cropType               String?
  notes                  String?
  preferredLanguage      String                @default("ta")
  status                 LeadStatus            @default(NEW)
  intakeChannel          IntakeChannel
  matchedCenter          OperatingCenter?      @relation(fields: [matchedCenterId], references: [id])
  matchedCenterId        String?
  distanceFromCenterKm   Float?

  // Comprehensive form fields
  soilType         String?
  cropAgeWeeks     Int?
  chemicalBrand    String?
  sprayPurpose     String?
  hasChemical      Boolean   @default(true)
  chemicalProofUrl String?
  expectedDate     DateTime?
  expectedTime     String?
  waterBodyNearby  Boolean   @default(false)
  terrainType      String?

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  assignment    Assignment?
  notifications Notification[]
  payments      PaymentRecord[]
  chatSessions  ChatSession[]
  sprayPurposes LeadSprayPurpose[]
  history       LeadHistory[]

  @@index([customerId, createdAt])
  @@index([businessOrganizationId, createdAt])
  @@index([farmLocationId, createdAt])
  @@index([cropId, createdAt])
}

// This is deliberately not a Lead: a declined request must never become
// schedulable or retain farm/route/acreage details. Contact fields support a
// short staff-recognition window only and are purged after the policy expiry.
model DeclinedEnquiry {
  id              String        @id @default(uuid())
  contactName     String
  contactPhone    String
  sourceChannel   IntakeChannel
  reason          String        @default("OUTSIDE_SERVICE_AREA")
  createdByUserId String?
  createdAt       DateTime      @default(now())
  expiresAt       DateTime

  @@index([expiresAt])
  @@index([contactPhone, createdAt])
}

model PricingConfig {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "DISCREPANCY_THRESHOLD_PCT"
  value     Float // placeholder values
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// One typed company policy exists per isolated deployment. User.preferences is
// intentionally not an operational-policy store.
model AutoAssignmentPolicy {
  id                        String                   @id @default(uuid())
  singletonKey              String                   @unique @default("COMPANY")
  enabled                   Boolean                  @default(true)
  searchHorizonDays         Int                      @default(5)
  workingDayStartMinutes    Int                      @default(540)
  workingDayEndMinutes      Int                      @default(1080)
  defaultJobDurationMinutes Int                      @default(120)
  turnaroundMinutes         Int                      @default(30)
  maxJobsPerUnitPerDay      Int?
  maxAcreagePerUnitPerDay   Decimal?                 @db.Decimal(12, 2)
  weatherUnavailableAction  WeatherUnavailableAction @default(SCHEDULE_WITH_WARNING)
  revision                  Int                      @default(1)
  updatedByUser             User?                    @relation("AutoAssignmentPolicyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedByUserId           String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([updatedByUserId])
}

model Assignment {
  id             String  @id @default(uuid())
  lead           Lead    @relation(fields: [leadId], references: [id])
  leadId         String  @unique
  pilot          User    @relation("PilotAssignments", fields: [pilotId], references: [id])
  pilotId        String
  copilot        User?   @relation("CopilotAssignments", fields: [copilotId], references: [id])
  copilotId      String?
  drone          Drone   @relation(fields: [droneId], references: [id])
  droneId        String
  // Deprecated compatibility alias. New writes keep this null (or equal to
  // droneId); a Copilot never introduces a second drone into the crew unit.
  copilotDrone   Drone?  @relation("CopilotDroneAssignments", fields: [copilotDroneId], references: [id])
  copilotDroneId String?
  lmv            LMV?    @relation(fields: [lmvId], references: [id])
  lmvId          String?

  crewFormationState     CrewFormationState @default(READY)
  revision               Int                @default(1)
  copilotSelectedAt      DateTime?
  crewFormationUpdatedAt DateTime           @default(now())

  scheduledDate        DateTime
  serviceWindowStart   DateTime?
  serviceWindowEnd     DateTime?
  dailySequence        Int       @default(1)
  // Set only by the compatibility migration for pre-existing incomplete
  // assignments. New operational assignments must always contain the full
  // two-pilot + drone + LMV unit; completing the crew clears this marker.
  legacyCrewIncomplete Boolean   @default(false)
  autoAssigned         Boolean   @default(true) // false if a Fleet Manager manually created/overrode it
  acceptedAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?

  weatherCheckedAt DateTime?
  weatherSuitable  Boolean?
  weatherNote      String?

  expectedAcreage Float
  actualAcreage   Float?
  cost            Float?
  hasDiscrepancy  Boolean @default(false)
  discrepancyNote String?

  decommissionedMidMission Boolean @default(false)
  decommissionReason       String?

  lastKnownLat Float? // live GPS, most recent ping only
  lastKnownLng Float?
  lastPingAt   DateTime?

  rescheduleHistory      ScheduleChangeLog[]
  payments               PaymentRecord[]
  notificationEscalation NotificationEscalation?
    mobileMutationReceipts MobileMutationReceipt[]
    createdAt              DateTime                @default(now())
    updatedAt              DateTime                @updatedAt

  @@index([scheduledDate, dailySequence])
  @@index([pilotId, scheduledDate])
  @@index([copilotId, scheduledDate])
  @@index([droneId, scheduledDate])
  @@index([lmvId, scheduledDate])
    @@index([crewFormationState, scheduledDate])
    @@index([updatedAt])
  }

// Persists the notification-cascade clock so a server restart never loses a pilot follow-up.
model NotificationEscalation {
  id            String     @id @default(uuid())
  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  assignmentId  String     @unique
  stage         String     @default("PUSH_SENT") // PUSH_SENT, SMS_SENT, CALL_TASK_CREATED
  nextActionAt  DateTime
  reassignCount Int        @default(0)
  closedAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([nextActionAt])
}

model ScheduleChangeLog {
  id           String     @id @default(uuid())
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  assignmentId String
  oldDate      DateTime
  newDate      DateTime
  changedBy    String
  reason       String?
  createdAt    DateTime   @default(now())
}

model ChatSession {
  id                  String    @id @default(uuid())
  lead                Lead?     @relation(fields: [leadId], references: [id])
  leadId              String?
  participants        User[]    @relation("ChatParticipants")
  status              String    @default("OPEN")
  firstResponseReadAt DateTime?
  lastActivityAt      DateTime  @default(now())
  archivedAt          DateTime?
  closedAt            DateTime?
  createdAt           DateTime  @default(now())

  messages ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(uuid())
  session   ChatSession @relation(fields: [sessionId], references: [id])
  sessionId String
  senderId  String
  content   String
  sentAt    DateTime    @default(now())
  readAt    DateTime?
}

model Notification {
  id          String           @id @default(uuid())
  type        NotificationType
  recipient   User             @relation(fields: [recipientId], references: [id])
  recipientId String
  lead        Lead?            @relation(fields: [leadId], references: [id])
  leadId      String?
  message     String
  readAt      DateTime?
  createdAt   DateTime         @default(now())
}

model PaymentRecord {
  id               String        @id @default(uuid())
  lead             Lead          @relation(fields: [leadId], references: [id])
  leadId           String
  assignment       Assignment    @relation(fields: [assignmentId], references: [id])
  assignmentId     String
  amount           Float
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  upiLink          String?
  upiTransactionId String?
  markedCashBy     String? // userId if manually marked collected
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?
}

// Append-only. Never updated or deleted — this is the source for the
// Logbook/CRM job-lifecycle timeline view
model AuditLog {
  id          String   @id @default(uuid())
  entityType  String // "Lead" | "Assignment" | "Drone" | ...
  entityId    String
  action      String // "STATUS_CHANGE" | "ADMIN_OVERRIDE" | "RESCHEDULE" | ...
  actorId     String? // null for system/automated actions
  beforeState Json?
  afterState  Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

// Controlled reference values. Customer-facing preferences and operational
// crops point here instead of storing arrays or unconstrained comma-separated
// text. Legacy flat fields remain during the compatibility release.
model Language {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(12)
  displayName String   @db.VarChar(80)
  nativeName  String?  @db.VarChar(80)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customerPreferences CustomerLanguagePreference[]

  @@index([active, displayName])
}

model Crop {
  id             String   @id @default(uuid())
  code           String   @unique @db.VarChar(40)
  displayName    String   @db.VarChar(120)
  normalizedName String   @unique @db.VarChar(120)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  seasonalCrops      CustomerSeasonalCrop[]
  leads              Lead[]
  historicalServices HistoricalServiceRecord[]
  villageVisits      VillageVisit[]

  @@index([active, displayName])
}

model Location {
  id            String   @id @default(uuid())
  countryCode   String   @default("IN") @db.VarChar(2)
  state         String?  @db.VarChar(120)
  district      String?  @db.VarChar(120)
  mandal        String?  @db.VarChar(120)
  village       String?  @db.VarChar(160)
  postalCode    String?  @db.VarChar(20)
  normalizedKey String   @unique @db.VarChar(640)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  operatingCenters OperatingCenter[]
  farmLocations    FarmLocation[]
  villageVisits    VillageVisit[]

  @@index([countryCode, state, district, mandal, village])
  @@index([active])
}

model FarmLocation {
  id                       String             @id @default(uuid())
  customer                 Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId               String
  administrativeLocation   Location?          @relation(fields: [administrativeLocationId], references: [id], onDelete: SetNull)
  administrativeLocationId String?
  label                    String?            @db.VarChar(120)
  addressText              String?            @db.VarChar(500)
  plusCode                 String?            @db.VarChar(20)
  latitude                 Decimal?           @db.Decimal(10, 7)
  longitude                Decimal?           @db.Decimal(10, 7)
  accuracyMeters           Decimal?           @db.Decimal(10, 2)
  source                   FarmLocationSource
  verifiedAt               DateTime?
  verifiedBy               User?              @relation("FarmLocationVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verifiedByUserId         String?
  active                   Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  leads              Lead[]
  historicalServices HistoricalServiceRecord[]

  @@index([customerId, active])
  @@index([administrativeLocationId])
  @@index([verifiedByUserId])
  @@index([plusCode])
}

model CustomerLanguagePreference {
  id          String              @id @default(uuid())
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  String
  language    Language            @relation(fields: [languageId], references: [id], onDelete: Restrict)
  languageId  String
  rank        Int
  proficiency LanguageProficiency @default(WORKING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([customerId, languageId])
  @@unique([customerId, rank])
  @@index([languageId])
}

model CustomerSeasonalCrop {
  id                String     @id @default(uuid())
  customer          Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId        String
  crop              Crop       @relation(fields: [cropId], references: [id], onDelete: Restrict)
  cropId            String
  season            CropSeason
  seasonYear        Int?
  acreage           Decimal?   @db.Decimal(12, 2)
  tankQuantity      Decimal?   @db.Decimal(12, 2)
  expectedSprayings Int?
  createdAt         DateTime   @default(now())
